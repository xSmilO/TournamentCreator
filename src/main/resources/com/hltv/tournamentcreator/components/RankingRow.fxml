<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<HBox alignment="CENTER_LEFT" spacing="12" styleClass="rank-row" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <Label fx:id="rank" styleClass="muted"/>
    <StackPane fx:id="mark" styleClass="team-mark"/>
    <VBox spacing="4" HBox.hgrow="ALWAYS"><Label fx:id="name" styleClass="identity-name"/><Label fx:id="players" styleClass="muted"/></VBox>
</HBox>
