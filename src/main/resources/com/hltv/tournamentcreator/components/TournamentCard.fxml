<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<HBox styleClass="tournament-card" minWidth="360" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <VBox fx:id="art" styleClass="tournament-art" alignment="TOP_CENTER" minWidth="64" maxWidth="64">
        <StackPane fx:id="icon"/>
    </VBox>
    <VBox spacing="12" styleClass="tournament-card-body" minWidth="0" HBox.hgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label fx:id="state" styleClass="card-state"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="delete" styleClass="card-delete" accessibleText="Delete tournament" focusTraversable="true">
                <tooltip><Tooltip text="Delete tournament"/></tooltip>
            </Button>
        </HBox>
        <Label fx:id="name" styleClass="card-title" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
        <Label fx:id="summary" styleClass="muted" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
        <Label fx:id="meta" styleClass="muted" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
        <Region VBox.vgrow="ALWAYS"/>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="card-actions">
            <Button fx:id="open" text="Manage" styleClass="primary, card-manage" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button fx:id="edit" text="Edit" styleClass="secondary, card-edit"/>
        </HBox>
    </VBox>
</HBox>
