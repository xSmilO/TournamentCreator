<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<TitledPane fx:id="pane" expanded="false" animated="false" styleClass="group-panel"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <content>
        <VBox spacing="12" styleClass="group-panel-content">
            <TableView fx:id="standings" prefHeight="225" minHeight="225" maxHeight="225">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="position" text="#" minWidth="60" maxWidth="75" sortable="false" reorderable="false"/>
                    <TableColumn fx:id="team" text="TEAM" minWidth="190" sortable="false" reorderable="false"/>
                    <TableColumn fx:id="played" text="P" minWidth="55" maxWidth="65" sortable="false" reorderable="false"/>
                    <TableColumn fx:id="wins" text="W" minWidth="55" maxWidth="65" sortable="false" reorderable="false"/>
                    <TableColumn fx:id="losses" text="L" minWidth="55" maxWidth="65" sortable="false" reorderable="false"/>
                    <TableColumn fx:id="maps" text="MAPS" minWidth="100" sortable="false" reorderable="false"/>
                    <TableColumn fx:id="difference" text="+ / −" minWidth="75" maxWidth="100" sortable="false" reorderable="false"/>
                    <TableColumn fx:id="points" text="PTS" minWidth="70" maxWidth="85" sortable="false" reorderable="false"/>
                </columns>
            </TableView>
            <Label fx:id="notice" styleClass="muted" wrapText="true"/>
            <Label text="GROUP MATCHES · Click a match to enter map scores" styleClass="eyebrow, accent"/>
            <VBox fx:id="fixtures" spacing="6"/>
        </VBox>
    </content>
</TitledPane>
