<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox id="creator-form" fx:id="playerCreatorContainer" maxWidth="560" maxHeight="580" prefWidth="560" spacing="20" stylesheets="@css/creator.css"
 xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hltv.tournamentcreator.controllers.PlayerCreatorController">
 <HBox alignment="CENTER_LEFT"><VBox spacing="6" HBox.hgrow="ALWAYS"><Label text="NEW ENTRY" styleClass="eyebrow"/><Label text="Create player" styleClass="creator-title"/></VBox><Button text="✕" onAction="#handleCancel" styleClass="secondary"/></HBox>
 <VBox spacing="6"><Label text="Nickname *" styleClass="input-label"/><TextField fx:id="nicknameField" promptText="Enter player nickname"/></VBox>
 <HBox spacing="14"><VBox spacing="6" HBox.hgrow="ALWAYS"><Label text="First name *" styleClass="input-label"/><TextField fx:id="firstNameField"/></VBox><VBox spacing="6" HBox.hgrow="ALWAYS"><Label text="Surname *" styleClass="input-label"/><TextField fx:id="surnameField"/></VBox></HBox>
 <HBox spacing="14">
  <VBox spacing="6" minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS">
   <Label text="Date of birth *" styleClass="input-label"/>
   <TextField fx:id="dateOfBirthField" minWidth="0" promptText="DD-MM-YYYY"/>
  </VBox>
  <VBox spacing="6" minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS">
   <Label text="Country *" styleClass="input-label"/>
   <ComboBox fx:id="countryBox" minWidth="0" prefWidth="0" maxWidth="Infinity" visibleRowCount="8"/>
  </VBox>
 </HBox>
 <Label fx:id="statusLabel" wrapText="true" styleClass="creator-status"/>
 <HBox alignment="CENTER_RIGHT" spacing="10"><Button fx:id="cancelBtn" text="Cancel" onAction="#handleCancel" styleClass="secondary"/><Button fx:id="addBtn" text="Create player  →" onAction="#handleSavePlayer" styleClass="primary"/></HBox>
</VBox>
