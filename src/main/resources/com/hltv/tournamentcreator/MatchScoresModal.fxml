<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox fx:id="scoreRoot" id="creator-form" styleClass="score-dialog" stylesheets="@css/creator.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <VBox spacing="6"><Label text="MATCH RESULTS" styleClass="eyebrow, accent"/><Label fx:id="scoreTitle" styleClass="creator-title" wrapText="true"/></VBox>
    <Label text="Enter round scores per map. Mark a finished map Completed. Bo1 needs 1 map win, Bo3 needs 2, and Bo5 needs 3. Leave unplayed maps Upcoming with 0–0." styleClass="muted" wrapText="true"/>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"><VBox fx:id="mapRows" spacing="14"/></ScrollPane>
    <Label fx:id="seriesSummary" styleClass="bracket-caption" wrapText="true"/>
    <TextField fx:id="correctionReason" promptText="Correction reason (required when changing completed results)"/><Label fx:id="scoreStatus" styleClass="creator-status" wrapText="true"/>
    <HBox alignment="CENTER_RIGHT" spacing="12"><Button text="Cancel" onAction="#backToManager" styleClass="secondary"/><Button id="save-match-scores" text="Save results" onAction="#saveScores" styleClass="primary"/></HBox>
</VBox>
