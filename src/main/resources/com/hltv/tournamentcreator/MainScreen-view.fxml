<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane fx:id="appRoot" styleClass="app-shell" prefWidth="1440" prefHeight="900" stylesheets="@css/app.css"
 xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hltv.tournamentcreator.controllers.MainController">
 <HBox>
  <VBox styleClass="sidebar" prefWidth="228" minWidth="228" maxWidth="228">
   <HBox styleClass="brand" alignment="CENTER_LEFT" spacing="11"><Label text="W" styleClass="brand-mark"/><Label text="WinIt" styleClass="brand-name"/><Label text="." styleClass="brand-dot"/></HBox>
   <VBox styleClass="workspace" spacing="12">
    <Label text="WORKSPACE" styleClass="eyebrow"/>
    <HBox styleClass="workspace-picker" alignment="CENTER_LEFT" spacing="10"><Label text="W" styleClass="workspace-logo"/><VBox spacing="3"><Label text="Competition hub" styleClass="workspace-title"/><Label text="Local workspace" styleClass="muted"/></VBox></HBox>
   </VBox>
   <Label text="MANAGE" styleClass="nav-caption"/>
   <VBox spacing="4">
    <Button fx:id="navDashboardBtn" text="Overview" onAction="#onDashboardClicked" styleClass="nav-item" maxWidth="Infinity"/>
    <Button fx:id="navTournamentsBtn" text="Tournaments" onAction="#onTournamentsClicked" styleClass="nav-item" maxWidth="Infinity"/>
    <Button fx:id="navTeamsBtn" text="Teams" onAction="#onTeamsClicked" styleClass="nav-item" maxWidth="Infinity"/>
    <Button fx:id="navPlayersBtn" text="Players" onAction="#onPlayersClicked" styleClass="nav-item" maxWidth="Infinity"/>
   </VBox>
   <Region VBox.vgrow="ALWAYS"/>
   <VBox styleClass="sidebar-footer" spacing="14"><Label text="YOUR COMPETITION. YOUR RULES." styleClass="eyebrow"/><HBox alignment="CENTER_LEFT" spacing="10"><Label text="W" styleClass="avatar"/><VBox spacing="4"><Label text="Tournament manager" styleClass="workspace-title"/><Label text="WinIt workspace" styleClass="muted"/></VBox></HBox></VBox>
  </VBox>
  <VBox HBox.hgrow="ALWAYS" minWidth="0">
   <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="14">
    <TextField fx:id="globalSearch" promptText="Search current directory..." styleClass="global-search" prefWidth="360"/>
    <Region HBox.hgrow="ALWAYS"/>
    <Label text="COMPETITION MANAGER" styleClass="eyebrow"/>
    <MenuButton text="＋  Create new" styleClass="primary"><items><MenuItem text="Tournament" onAction="#createTournament"/><MenuItem text="Team" onAction="#createTeam"/><MenuItem text="Player" onAction="#createPlayer"/></items></MenuButton>
   </HBox>
   <StackPane fx:id="contentPane" VBox.vgrow="ALWAYS" minHeight="0"/>
  </VBox>
 </HBox>
 <StackPane fx:id="modalOverlay" styleClass="modal-overlay" visible="false"/>
</StackPane>
