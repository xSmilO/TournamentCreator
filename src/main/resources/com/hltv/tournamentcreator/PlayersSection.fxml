<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox styleClass="directory" stylesheets="@css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hltv.tournamentcreator.controllers.PlayerSectionController">
    <HBox styleClass="page-heading" spacing="20" alignment="CENTER_LEFT">
        <VBox spacing="7" HBox.hgrow="ALWAYS">
            <Label text="WINIT COMPETITION DATABASE" styleClass="eyebrow, accent"/>
            <Label text="Players." styleClass="page-title"/>
            <Label text="Manage every player in your competition network." styleClass="page-description"/>
        </VBox>
        <Button id="add-btn" text="＋  Add player" styleClass="primary" onAction="#createEntry"/>
    </HBox>
    <VBox styleClass="panel" minHeight="0" VBox.vgrow="ALWAYS">
        <HBox styleClass="directory-toolbar" alignment="CENTER_LEFT" spacing="12">
            <TextField fx:id="search" promptText="Search players..." styleClass="directory-search" HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="filter"/>
            <Button fx:id="refresh" text="↻  Refresh" styleClass="secondary" onAction="#loadData"/>
        </HBox>
            <TableView fx:id="table" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                <placeholder><Label text="No players to display. Create one to get started." styleClass="muted"/></placeholder>
                <columns>
                    <TableColumn text="PLAYER" minWidth="230" prefWidth="300" reorderable="false"/>
                    <TableColumn text="COUNTRY" minWidth="90" reorderable="false"/>
                    <TableColumn text="TEAM" minWidth="90" reorderable="false"/>
                    <TableColumn text="HLTV RATING" minWidth="90" reorderable="false"/>
                    <TableColumn text="HEADSHOTS" minWidth="90" reorderable="false"/>
                </columns>
            </TableView>
        <Label fx:id="status" styleClass="directory-status" wrapText="true"/>
    </VBox>
</VBox>
