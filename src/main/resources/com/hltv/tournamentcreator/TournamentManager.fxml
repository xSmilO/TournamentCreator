<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox fx:id="managerRoot" id="tournament-manager" styleClass="detail-dialog, tournament-manager" stylesheets="@css/creator.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox spacing="6" HBox.hgrow="ALWAYS"><Label text="TOURNAMENT CONTROL" styleClass="eyebrow, accent"/><Label fx:id="title" styleClass="creator-title" wrapText="true"/></VBox>
        <Button text="Event control" onAction="#eventControl" styleClass="secondary"/><Button text="Close" onAction="#close" styleClass="secondary"/>
    </HBox>
    <TabPane fx:id="tabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" minHeight="0">
        <tabs>
            <Tab text="Teams">
                <VBox spacing="14" styleClass="tournament-tab">
                    <HBox alignment="CENTER_LEFT" spacing="12"><Label text="Registered teams and seeding" styleClass="panel-title" HBox.hgrow="ALWAYS"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="editSeed" text="Edit seed" onAction="#editSeed" styleClass="secondary"/><Button fx:id="removeTeam" text="Remove selected team" onAction="#removeTeam" styleClass="secondary"/><Button fx:id="addTeams" text="＋  Add teams" onAction="#showTeamPicker" styleClass="primary"/></HBox>
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="Team limit" styleClass="input-label"/>
                        <Label fx:id="teamLimitValue" styleClass="muted"/>
                        <HBox fx:id="teamLimitEditor" alignment="CENTER_LEFT" spacing="12" visible="false" managed="false">
                            <TextField fx:id="teamLimitField" promptText="2–256" prefWidth="90" maxWidth="90"/>
                            <Button fx:id="saveLimit" text="Save limit" styleClass="secondary" onAction="#updateTeamLimit"/>
                        </HBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="capacityLabel" styleClass="muted"/>
                    </HBox>
                    <TableView fx:id="participantsTable" VBox.vgrow="ALWAYS">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                        <placeholder><Label text="No registered teams. Click Add teams to register your participants." wrapText="true"/></placeholder>
                        <columns><TableColumn fx:id="participantSeed" text="SEED" minWidth="90" maxWidth="120"/><TableColumn fx:id="participantName" text="TEAM" minWidth="250"/></columns>
                    </TableView>
                    <Label text="Open registration in Event control to add/remove teams. Changes close when groups/a bracket are generated or the event starts. Teams with scheduled matches cannot be removed." styleClass="muted" wrapText="true"/>
                </VBox>
            </Tab>
            <Tab fx:id="matchesTab" text="Matches">
                <VBox spacing="14" styleClass="tournament-tab">
                    <HBox alignment="CENTER_LEFT" spacing="12"><Label text="Matches and map results" styleClass="panel-title"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="editOutcome" text="Outcome / reset" onAction="#editOutcome" styleClass="secondary"/><Button fx:id="editSchedule" text="Schedule" onAction="#editSchedule" styleClass="secondary"/><Button fx:id="editMatchFormat" text="Format" onAction="#editMatchFormat" styleClass="secondary"/><Button fx:id="addMatch" text="＋  Add match" onAction="#showMatchCreator" styleClass="secondary"/><Button fx:id="editScores" text="Enter / edit scores" onAction="#editSelectedScores" styleClass="primary"/></HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Status" styleClass="muted"/>
                        <ComboBox fx:id="matchStatusFilter" value="All statuses" prefWidth="150" styleClass="compact-combo" accessibleText="Filter matches by status">
                            <items><FXCollections fx:factory="observableArrayList">
                                <String fx:value="All statuses"/>
                                <String fx:value="Live"/>
                                <String fx:value="Upcoming"/>
                                <String fx:value="Completed"/>
                            </FXCollections></items>
                        </ComboBox>
                    </HBox>
                    <TableView fx:id="matchesTable" VBox.vgrow="ALWAYS">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                        <placeholder><Label fx:id="matchesPlaceholder" text="No matches yet. Generate a bracket or add a match manually."/></placeholder>
                        <columns><TableColumn fx:id="matchOpponents" text="MATCH" minWidth="260"/><TableColumn fx:id="matchSeriesFormat" text="FORMAT" minWidth="72"/><TableColumn fx:id="matchScore" text="MAPS" minWidth="80"/><TableColumn fx:id="matchStatus" text="STATUS" minWidth="110"/><TableColumn fx:id="matchRound" text="ROUND" minWidth="110"/><TableColumn fx:id="matchStart" text="START" minWidth="130"/></columns>
                    </TableView>
                    <Label text="Series scores count completed map wins. Round scores (for example 13–10) are entered separately for each map." styleClass="muted" wrapText="true"/>
                </VBox>
            </Tab>
            <Tab text="Groups">
                <VBox spacing="12" styleClass="tournament-tab" minHeight="0">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="4 teams per group · top 2 advance" styleClass="panel-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="groupFormat" value="Bo3" styleClass="compact-combo"><items><FXCollections fx:factory="observableArrayList"><String fx:value="Bo1"/><String fx:value="Bo3"/><String fx:value="Bo5"/></FXCollections></items></ComboBox>
                        <Button fx:id="drawGroups" text="Draw groups" styleClass="primary" onAction="#generateGroups"/>
                    </HBox>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="Playoff match format" styleClass="muted"/><Region HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="playoffFormat" value="Bo3" styleClass="compact-combo"><items><FXCollections fx:factory="observableArrayList"><String fx:value="Bo1"/><String fx:value="Bo3"/><String fx:value="Bo5"/></FXCollections></items></ComboBox>
                        <Button fx:id="qualifyGroups" text="Generate playoffs" styleClass="secondary" onAction="#generateGroupPlayoffs"/>
                    </HBox>
                    <Label text="Win: 3 pts · Loss: 0 pts. Ties: head-to-head among tied teams → map difference → maps won → original seed." styleClass="muted" wrapText="true"/>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" minHeight="0"><VBox fx:id="groupPanels" spacing="12"/></ScrollPane>
                    <Label fx:id="groupProgress" styleClass="bracket-caption" wrapText="true"/>
                </VBox>
            </Tab>
            <Tab text="Bracket">
                <VBox spacing="14" styleClass="tournament-tab" minHeight="0">
                    <CheckBox fx:id="randomDraw" text="Random draw (uncheck to use tournament seeds)" selected="true"/>
                    <Label text="Register teams, choose a format and generate the bracket. Click a match to enter map scores; the winner advances automatically. The saved draw cannot be repeated." styleClass="muted" wrapText="true"/>
                    <HBox spacing="12" alignment="CENTER_LEFT"><Label text="Single elimination" styleClass="panel-title"/><Region HBox.hgrow="ALWAYS"/><ComboBox fx:id="bracketFormat" value="Bo3" styleClass="compact-combo"><items><FXCollections fx:factory="observableArrayList"><String fx:value="Bo1"/><String fx:value="Bo3"/><String fx:value="Bo5"/></FXCollections></items></ComboBox><Button fx:id="generate" text="Generate bracket" onAction="#generateBracket" styleClass="primary"/></HBox>
                    <ScrollPane fitToHeight="false" fitToWidth="false" VBox.vgrow="ALWAYS" minHeight="0"><HBox fx:id="bracketColumns"/></ScrollPane>
                    <Label fx:id="champion" styleClass="bracket-caption" wrapText="true"/>
                </VBox>
            </Tab>
        </tabs>
    </TabPane>
    <HBox alignment="CENTER_LEFT" spacing="12"><Label fx:id="managerStatus" styleClass="muted" wrapText="true" HBox.hgrow="ALWAYS"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="refresh" text="↻  Refresh" onAction="#refresh" styleClass="secondary"/></HBox>
</VBox>
