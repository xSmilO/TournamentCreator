<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<FlowPane id="container" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="540.0" prefWidth="600.0" stylesheets="@css/playerCreator.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hltv.tournamentcreator.controllers.PlayerCreatorController">
    <children>
        <VBox>
            <children>
                <Label styleClass="inputLabel" stylesheets="@css/playerCreator.css" text="Name:" />
                <TextField fx:id="nameField" styleClass="input" />
            </children>
        </VBox>
        <VBox>
            <children>
                <Label styleClass="inputLabel" stylesheets="@css/playerCreator.css" text="Surname:" />
                <TextField fx:id="surnameField" styleClass="input" />
            </children>
        </VBox>
        <VBox>
            <children>
                <Label styleClass="inputLabel" stylesheets="@css/playerCreator.css" text="Country:" />
                <ComboBox id="contryBox" fx:id="countryBox" prefWidth="150.0" />
            </children>
        </VBox>
        <VBox>
            <children>
                <Label styleClass="inputLabel" stylesheets="@css/playerCreator.css" text="Nickname:" />
                <TextField fx:id="nicknameField" styleClass="input" />
            </children>
        </VBox>
        <VBox>
            <children>
                <Label styleClass="inputLabel" stylesheets="@css/playerCreator.css" text="Date of birth" />
                <DatePicker fx:id="dateOfBirthPicker" styleClass="datePicker" />
            </children>
        </VBox>
      <Button mnemonicParsing="false" onAction="#handleSavePlayer" text="Save" />
    </children>
</FlowPane>
