<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox fx:id="root" id="creator-form" prefWidth="480" maxWidth="480" maxHeight="-Infinity" spacing="12" stylesheets="@css/creator.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
 <VBox spacing="4">
  <Label text="DELETE TOURNAMENT" styleClass="eyebrow, accent"/>
  <Label fx:id="title" styleClass="creator-title" wrapText="true"/>
 </VBox>
 <Label text="Permanently deletes this tournament, including its scores and history. Teams and players are kept." styleClass="muted" wrapText="true" minHeight="-Infinity"/>
 <VBox styleClass="form-field">
  <Label text="Type the exact tournament name to confirm" styleClass="input-label"/>
  <TextField fx:id="confirmation" promptText="Tournament name"/>
 </VBox>
 <Label fx:id="status" styleClass="creator-status" wrapText="true" minHeight="-Infinity"/>
 <HBox alignment="CENTER_RIGHT" spacing="12"><Button text="Cancel" styleClass="secondary" onAction="#cancel"/><Button fx:id="delete" text="Delete permanently" styleClass="primary" onAction="#delete"/></HBox>
</VBox>
