<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<!-- The TeamRosterDialog instance is supplied by FxmlViews so it keeps the selected team. -->
<VBox fx:id="rosterRoot" id="roster-dialog" styleClass="detail-dialog, roster-dialog" stylesheets="@css/creator.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <VBox spacing="6"><Label text="TEAM ROSTER" styleClass="eyebrow, accent"/><Label fx:id="rosterTitle" styleClass="creator-title" wrapText="true"/></VBox>
    <TableView fx:id="rosterTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        <placeholder><Label text="No players in this roster yet."/></placeholder>
        <columns>
            <TableColumn fx:id="nicknameColumn" text="NICKNAME" minWidth="100" reorderable="false"/>
            <TableColumn fx:id="nameColumn" text="NAME" minWidth="100" reorderable="false"/>
            <TableColumn fx:id="countryColumn" text="COUNTRY" minWidth="100" reorderable="false"/>
            <TableColumn fx:id="ratingColumn" text="RATING" minWidth="100" reorderable="false"/>
            <TableColumn fx:id="roleColumn" text="ROLE" minWidth="100" reorderable="false"/>
        </columns>
    </TableView>
    <Label fx:id="rosterStatus" text="Loading roster…" styleClass="muted" wrapText="true"/>
    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button text="↻  Refresh" styleClass="secondary" onAction="#showRoster"/>
        <Button text="Close" styleClass="secondary" onAction="#close"/>
        <Button text="＋  Add player" styleClass="primary" onAction="#showPlayerPicker"/>
    </HBox>
</VBox>
