<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox fx:id="pickerRoot" id="roster-dialog" styleClass="detail-dialog, roster-dialog" stylesheets="@css/creator.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <VBox spacing="6"><Label fx:id="pickerCaption" text="ADD PLAYER" styleClass="eyebrow, accent"/><Label text="Choose a player" styleClass="creator-title"/></VBox>
    <VBox spacing="12" VBox.vgrow="ALWAYS">
        <TextField fx:id="search" id="player-search" promptText="Search nickname, name or country…"/>
        <TableView fx:id="playerTable" id="available-players-table" VBox.vgrow="ALWAYS" onMouseClicked="#selectClickedPlayer" onKeyPressed="#onPlayerKey">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            <placeholder><Label fx:id="pickerPlaceholder" text="Loading players…"/></placeholder>
            <columns>
                <TableColumn fx:id="nicknameColumn" text="NICKNAME" minWidth="100" reorderable="false"/>
                <TableColumn fx:id="nameColumn" text="NAME" minWidth="100" reorderable="false"/>
                <TableColumn fx:id="countryColumn" text="COUNTRY" minWidth="100" reorderable="false"/>
                <TableColumn fx:id="ratingColumn" text="RATING" minWidth="100" reorderable="false"/>
            </columns>
        </TableView>
    </VBox>
    <Label fx:id="pickerStatus" text="Loading available players…" styleClass="muted" wrapText="true"/>
    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button fx:id="pickerRefresh" text="↻  Refresh" styleClass="secondary" onAction="#loadAvailable"/>
        <Button text="Back to roster" styleClass="secondary" onAction="#backToRoster"/>
        <Button fx:id="choose" text="Choose player  →" styleClass="primary" onAction="#chooseSelectedPlayer"/>
    </HBox>
</VBox>
