<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox fx:id="roleRoot" id="role-prompt" styleClass="detail-dialog, role-dialog" stylesheets="@css/creator.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <VBox spacing="6"><Label fx:id="roleCaption" text="ASSIGN ROLE" styleClass="eyebrow, accent"/><Label fx:id="roleTitle" styleClass="creator-title" wrapText="true"/></VBox>
    <VBox spacing="18" VBox.vgrow="ALWAYS">
        <Label fx:id="rolePrompt" styleClass="page-description" wrapText="true"/>
        <Label text="Team role *" styleClass="input-label"/>
        <ComboBox fx:id="role" id="player-role" editable="true" promptText="Choose or type a role" maxWidth="Infinity">
            <items><FXCollections fx:factory="observableArrayList"><String fx:value="IGL"/><String fx:value="AWPer"/><String fx:value="Entry fragger"/><String fx:value="Lurker"/><String fx:value="Support"/><String fx:value="Rifler"/><String fx:value="Substitute"/><String fx:value="Coach"/></FXCollections></items>
        </ComboBox>
    </VBox>
    <Label fx:id="roleStatus" styleClass="creator-status" wrapText="true"/>
    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button fx:id="roleBack" text="Back to players" styleClass="secondary" onAction="#cancelRole"/>
        <Button fx:id="confirmRoleButton" id="confirm-player-role" text="Add to team  →" styleClass="primary" onAction="#confirmRole"/>
    </HBox>
</VBox>
